# Neon PostgreSQL（Vercel 本番では Pooled connection を DATABASE_URL に設定）
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon Direct connection（ローカルから db:push / db:seed するときに使用）
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth.js secret（PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))）
AUTH_SECRET="your-random-secret-here"
